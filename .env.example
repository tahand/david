# Copy to .env for local development. In production these live in /etc/clinic-app/.env (mode 600).
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://app_user:CHANGE_ME@127.0.0.1:5432/clinic
MIGRATION_DATABASE_URL=postgresql://app_migrator:CHANGE_ME@127.0.0.1:5432/clinic
# 64 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SESSION_SECRET=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1
CLINIC_TIMEZONE=Europe/London
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Clinic <no-reply@example.com>
HIBP_CHECK_ENABLED=true
