# Copy to .env for local development. In production these live in /etc/clinic-app/.env (mode 600).
# The database URLs below match docker-compose.dev.yml; production uses port 5432 and real passwords.
NODE_ENV=development
PORT=4000
# Listen address. Keep loopback outside Docker; docker-compose.local.yml sets 0.0.0.0.
HOST=127.0.0.1
APP_URL=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://app_user:app_user_dev@127.0.0.1:5433/clinic
MIGRATION_DATABASE_URL=postgresql://app_migrator:app_migrator_dev@127.0.0.1:5433/clinic
# 64 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SESSION_SECRET=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1
CLINIC_TIMEZONE=Europe/London
SMTP_HOST=localhost
# Dev: Mailpit from docker-compose.dev.yml (UI on http://localhost:8025). Production: 587 or 465.
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Clinic <no-reply@example.com>
HIBP_CHECK_ENABLED=true
