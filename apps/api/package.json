{
  "name": "@clinic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@clinic/source --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/prisma-migrator.mjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma-migrator.mjs migrate dev",
    "db:seed": "tsx --conditions=@clinic/source prisma/seed.ts",
    "db:status": "node scripts/prisma-migrator.mjs migrate status",
    "test:db": "vitest run --config vitest.db.config.ts",
    "create-admin": "tsx --conditions=@clinic/source scripts/create-admin.ts"
  },
  "dependencies": {
    "@clinic/shared": "*",
    "@prisma/client": "~6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "otplib": "^13.5.0",
    "pdfkit": "^0.17.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "prisma": "~6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
