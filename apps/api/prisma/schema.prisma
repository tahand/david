// Data model — SPEC §8.
//
// Conventions: snake_case tables/columns mapped to camelCase fields; uuid PKs
// generated by Postgres; timestamptz everywhere. Columns ending in `Enc` hold
// AES-256-GCM envelopes (lib/crypto.ts) that embed the key version.
//
// Constraints Prisma cannot express (exclusion constraint, CHECKs, grants,
// append-only triggers) live in hand-written SQL in the migrations.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist]
}

enum Role {
  patient
  doctor
  receptionist
  admin

  @@map("role")
}

enum EmailTokenType {
  verify_email
  reset_password

  @@map("email_token_type")
}

enum SexAtBirth {
  female
  male
  intersex
  not_stated

  @@map("sex_at_birth")
}

enum PreferredContact {
  email
  sms
  phone

  @@map("preferred_contact")
}

enum AvailabilityExceptionType {
  unavailable
  extra

  @@map("availability_exception_type")
}

enum AppointmentStatus {
  booked
  confirmed
  checked_in
  completed
  cancelled_by_patient
  cancelled_by_clinic
  no_show

  @@map("appointment_status")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique @db.Citext
  passwordHash     String    @map("password_hash")
  role             Role
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc     String?   @map("mfa_secret_enc")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  isActive         Boolean   @default(true) @map("is_active")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  recoveryCodes      MfaRecoveryCode[]
  sessions           Session[]
  emailTokens        EmailToken[]
  patient            Patient?
  doctor             Doctor?
  bookedAppointments Appointment[]      @relation("BookedBy")
  appointmentEvents  AppointmentEvent[]

  @@map("users")
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SHA-256 of the 256-bit cookie value; the raw ID is never stored.
  idHash     String   @unique @map("id_hash")
  userId     String   @map("user_id") @db.Uuid
  mfaPending Boolean  @default(false) @map("mfa_pending")
  ip         String?
  userAgent  String?  @map("user_agent")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Absolute expiry (12 h, or 5 min while MFA is pending). Idle timeout is derived from lastSeenAt.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

model Patient {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nullable: receptionists may create patients without a login.
  userId              String?          @unique @map("user_id") @db.Uuid
  title               String?
  firstName           String           @map("first_name")
  middleNames         String?          @map("middle_names")
  lastName            String           @map("last_name")
  preferredName       String?          @map("preferred_name")
  dateOfBirth         DateTime         @map("date_of_birth") @db.Date
  sexAtBirth          SexAtBirth?      @map("sex_at_birth")
  genderIdentity      String?          @map("gender_identity")
  pronouns            String?
  healthIdEnc         String?          @map("health_id_enc")
  preferredLanguage   String?          @map("preferred_language")
  interpreterRequired Boolean          @default(false) @map("interpreter_required")
  /// Contact email for patients without a login (patients with a login use users.email).
  contactEmail        String?          @map("contact_email") @db.Citext
  phoneMobile         String?          @map("phone_mobile")
  phoneAlt            String?          @map("phone_alt")
  addressLine1        String?          @map("address_line1")
  addressLine2        String?          @map("address_line2")
  city                String?
  region              String?
  postcode            String?
  country             String?
  preferredContact    PreferredContact @default(email) @map("preferred_contact")
  reminderConsent     Boolean          @default(false) @map("reminder_consent")
  emergencyContactEnc String?          @map("emergency_contact_enc")
  medicalSummaryEnc   String?          @map("medical_summary_enc")
  gpDetails           Json?            @map("gp_details")
  accessibilityNeeds  String?          @map("accessibility_needs")
  consentVersion      String?          @map("consent_version")
  consentAt           DateTime?        @map("consent_at") @db.Timestamptz(6)
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User?          @relation(fields: [userId], references: [id])
  appointments  Appointment[]
  clinicalNotes ClinicalNote[]

  @@index([lastName])
  @@index([dateOfBirth])
  @@index([postcode])
  @@index([phoneMobile])
  @@map("patients")
}

model Doctor {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  displayName        String   @map("display_name")
  specialty          String?
  registrationNumber String?  @map("registration_number")
  bio                String?
  isBookable         Boolean  @default(true) @map("is_bookable")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                   User                    @relation(fields: [userId], references: [id])
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  clinicalNotes          ClinicalNote[]

  @@map("doctors")
}

model AppointmentType {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @unique
  durationMinutes Int      @map("duration_minutes")
  colour          String
  patientBookable Boolean  @default(true) @map("patient_bookable")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointments Appointment[]

  @@map("appointment_types")
}

model AvailabilityRule {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId  String    @map("doctor_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday (matches JS Date#getDay).
  weekday   Int       @db.SmallInt
  /// Wall-clock time in the clinic timezone.
  startTime DateTime  @map("start_time") @db.Time(0)
  endTime   DateTime  @map("end_time") @db.Time(0)
  validFrom DateTime  @default(dbgenerated("CURRENT_DATE")) @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, weekday])
  @@map("availability_rules")
}

model AvailabilityException {
  id        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId  String                    @map("doctor_id") @db.Uuid
  startsAt  DateTime                  @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime                  @map("ends_at") @db.Timestamptz(6)
  type      AvailabilityExceptionType
  reason    String?
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt])
  @@map("availability_exceptions")
}

model Appointment {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId         String            @map("patient_id") @db.Uuid
  doctorId          String            @map("doctor_id") @db.Uuid
  appointmentTypeId String            @map("appointment_type_id") @db.Uuid
  startsAt          DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime          @map("ends_at") @db.Timestamptz(6)
  status            AppointmentStatus @default(booked)
  reasonForVisitEnc String?           @map("reason_for_visit_enc")
  bookedByUserId    String            @map("booked_by_user_id") @db.Uuid
  cancelledReason   String?           @map("cancelled_reason")
  reminderSentAt    DateTime?         @map("reminder_sent_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient         Patient            @relation(fields: [patientId], references: [id])
  doctor          Doctor             @relation(fields: [doctorId], references: [id])
  appointmentType AppointmentType    @relation(fields: [appointmentTypeId], references: [id])
  bookedBy        User               @relation("BookedBy", fields: [bookedByUserId], references: [id])
  events          AppointmentEvent[]
  clinicalNotes   ClinicalNote[]

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([startsAt])
  @@map("appointments")
}

model AppointmentEvent {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String             @map("appointment_id") @db.Uuid
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  /// Null for system actions (e.g. scheduled jobs).
  actorUserId   String?            @map("actor_user_id") @db.Uuid
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  actor       User?       @relation(fields: [actorUserId], references: [id])

  @@index([appointmentId])
  @@map("appointment_events")
}

model ClinicalNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId  String   @map("appointment_id") @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  authorDoctorId String   @map("author_doctor_id") @db.Uuid
  bodyEnc        String   @map("body_enc")
  /// Append-only: corrections are new rows pointing at the note they amend.
  amendsNoteId   String?  @map("amends_note_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointment  Appointment    @relation(fields: [appointmentId], references: [id])
  patient      Patient        @relation(fields: [patientId], references: [id])
  authorDoctor Doctor         @relation(fields: [authorDoctorId], references: [id])
  amends       ClinicalNote?  @relation("Amendments", fields: [amendsNoteId], references: [id])
  amendments   ClinicalNote[] @relation("Amendments")

  @@index([appointmentId])
  @@index([patientId])
  @@map("clinical_notes")
}

/// Append-only (no UPDATE/DELETE for app_user, enforced by trigger too).
/// actor_user_id deliberately has no FK so the trail survives user erasure.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  ip          String?
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ClinicSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("clinic_settings")
}

model RateLimit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  points    Int      @default(0)
  expire    DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expire])
  @@map("rate_limits")
}
